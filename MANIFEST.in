# Documentation
include README.md
include LICENSE
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md

# SHL source code
recursive-include shl *.py
recursive-include shl *.json
recursive-include shl *.json.gz
recursive-include shl *.txt

# Tests (included in sdist, not installed)
recursive-include tests *.py

# Documentation sources
recursive-include doc *.md
recursive-include doc *.py
recursive-include doc *.yml
recursive-include doc *.yaml

# Example data (optional - for users to see structure)
recursive-include examples *.py
recursive-include examples *.json
recursive-include locales *.json
recursive-include prompts *.json

# Exclude unnecessary files
global-exclude *.pyc
global-exclude *.pyo
global-exclude __pycache__
global-exclude .DS_Store
global-exclude .git*
global-exclude .env
global-exclude *.bak
global-exclude *.tmp
global-exclude .coverage
global-exclude coverage.xml
global-exclude *.log

# Exclude development files
global-exclude .mypy_cache
global-exclude .pytest_cache
global-exclude .ruff_cache
global-exclude .tox
global-exclude build/
global-exclude dist/
global-exclude *.egg-info/
